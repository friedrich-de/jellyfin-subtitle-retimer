<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Test names read as sentences, test types stay public for the runner, and JSON keys are not member names. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1507</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- No reference to the plugin project: these tests drive the packaged zip through a real server. -->
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
