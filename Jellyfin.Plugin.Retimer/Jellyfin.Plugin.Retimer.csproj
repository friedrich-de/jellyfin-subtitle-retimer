<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Retimer</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Retimer</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server ships these assemblies, so the plugin must not carry its own copies. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\index.html" />
    <EmbeddedResource Include="Web\app.js" />
    <EmbeddedResource Include="Web\app.css" />
    <EmbeddedResource Include="Web\manifest.webmanifest" />
    <EmbeddedResource Include="Web\sw.js" />
    <!-- The served icons only; the SVG files they are drawn from (dev/render-icons.js) stay out. -->
    <EmbeddedResource Include="Web\icons\*.png;Web\icons\favicon.svg" LogicalName="Jellyfin.Plugin.Retimer.Web.icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Retimer.Tests" />
  </ItemGroup>

</Project>
